DATABASE_URL=postgresql+asyncpg://trace:trace@db:5432/trace
DATABASE_URL_SYNC=postgresql://trace:trace@db:5432/trace
IMPOSSIBLE_JOURNEY_SPEED_MULTIPLIER=1.5
IDENTITY_CONFIRM_THRESHOLD=0.70
IDENTITY_CANDIDATE_THRESHOLD=0.40
ANALYTICS_WINDOW_SECONDS=300
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_EXPIRY_MINUTES=480

# Hardware Acceleration & Real-Time Performance Optimizations
YOLO_DEVICE=cuda:0
APPEARANCE_DEVICE=cuda
YOLO_FRAME_STRIDE=2
OCR_CONFIDENCE_THRESHOLD=0.50
ACTIVE_CAMERA_COUNT=2
